LINKSYNC_HOST=0.0.0.0
LINKSYNC_PORT=8787
LINKSYNC_DATA_DIR=./data
LINKSYNC_PUBLIC_URL=https://links.example.com
LINKSYNC_LAN_URL=https://links.home.example.com
# Optional, useful for deterministic first-time setup in automation:
# LINKSYNC_SETUP_TOKEN=replace-with-a-long-random-secret
# Comma-separated proxy IPs/CIDRs allowed to provide X-Forwarded-For.
# Leave empty unless the server receives traffic through a known proxy.
# LINKSYNC_TRUSTED_PROXY_CIDRS=127.0.0.1,::1
